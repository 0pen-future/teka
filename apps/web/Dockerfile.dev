# Dev-only image: compose bind-mounts ./apps/web over /app with an anonymous
# volume shadowing /app/node_modules, so dependencies stay container-built
# (linux binaries) while source edits hot-reload via Vite HMR.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 5173

# --host binds 0.0.0.0 so the mapped port is reachable from the host browser.
CMD ["npm", "run", "dev", "--", "--host"]
