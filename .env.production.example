# Copy to .env.production and replace every placeholder. Never commit the copy.
# Images are published only by vX.Y.Z release tags (api-release.yml and
# web-release.yml), so pin the version — sha-<commit> exists only for
# tagged commits.
API_IMAGE=ghcr.io/OWNER/REPO/api:X.Y.Z
WEB_IMAGE=ghcr.io/OWNER/REPO/web:X.Y.Z
API_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
API_JWT_SECRET=REPLACE_ME
API_STATEMENTS_TOKEN_KEY=REPLACE_ME
# Encrypts linked Zalo session credentials. Rotating it forces every teacher to
# re-scan a QR code, so set it once and back it up with the database.
API_ZALO_CRED_KEY=REPLACE_ME

# WEB_IMAGE must be built with:
# VITE_API_URL=https://teka-api.cauchuyenlaptrinh.com/api/v1
