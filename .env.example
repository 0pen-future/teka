# Copy to .env for local development: cp .env.example .env
# Compose interpolates these; each service receives only its own variables.

# --- PostgreSQL ---
POSTGRES_USER=teka
POSTGRES_PASSWORD=teka_dev_password
POSTGRES_DB=teka
POSTGRES_PORT=5432

# --- Backend API ---
API_ENV=development
API_HTTP_PORT=8080
# Host-mode value (running the API directly on your machine). Docker Compose
# builds its own URL from the POSTGRES_* variables with host "postgres" and
# overrides this per-service; it never reads this value. If you change
# POSTGRES_PORT above, update the port here too — they are not linked.
API_DATABASE_URL=postgres://teka:teka_dev_password@localhost:5432/teka?sslmode=disable
# Min 32 chars. Generate: openssl rand -base64 32
API_JWT_SECRET=change-me-dev-only-secret-at-least-32-chars
API_JWT_ACCESS_TTL=15m
API_JWT_REFRESH_TTL=720h
API_LOG_LEVEL=debug
# Both loopback spellings: Vite prints localhost, but a hand-typed
# http://127.0.0.1:5173 is a different origin to the browser.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Connection pool (defaults shown; uncomment to override)
# API_DB_MAX_OPEN_CONNS=25
# API_DB_MAX_IDLE_CONNS=5
# API_DB_CONN_MAX_LIFETIME=30m
# Min 32 bytes, hex or base64. Generate: openssl rand -base64 32
# Rotating this invalidates all parent statement links.
API_STATEMENTS_TOKEN_KEY=change-me-dev-only-statements-key-32-bytes
# Parent-facing origin that tokenised statement links resolve against.
API_STATEMENTS_PUBLIC_BASE_URL=http://localhost:5173
# Bank transfer target rendered into the parent statement's VietQR. All three
# are optional: leave them blank and the statement simply omits the QR block.
API_BANK_CODE=
API_BANK_ACCOUNT_NUMBER=
API_BANK_ACCOUNT_NAME=
# Channel used when a bulk-send request omits "channel" — the web UI always
# sends one explicitly, so this only steers non-UI callers — and the character
# ceiling before a message collapses its per-child detail into the link.
API_NOTIFICATIONS_DEFAULT_CHANNEL=zalo_manual
API_NOTIFICATIONS_MAX_MESSAGE_LEN=1000
# zalo_personal auto-send pacing: each DM in a run waits a random gap in
# [min,max] seconds so the traffic looks like a person typing, and one bulk
# send may auto-deliver at most MAX_RUN_SIZE messages.
API_NOTIFICATIONS_PACE_MIN_SECONDS=3
API_NOTIFICATIONS_PACE_MAX_SECONDS=8
API_NOTIFICATIONS_MAX_RUN_SIZE=50
# Encrypts the Zalo session credentials of teachers who linked their personal
# account. Min 32 bytes, hex or base64. Generate: openssl rand -base64 32
# Rotating this makes every stored credential undecryptable — each teacher has
# to scan a new QR code — so treat it as permanent. Required in production;
# outside production a missing key falls back to a random per-process one.
# Left too short to satisfy production on purpose: a placeholder that passes
# validation is one that reaches production, and this key guards credentials
# that can take over a teacher's Zalo account.
API_ZALO_CRED_KEY=REPLACE_ME

# --- Web ---
# Reference only — Vite never reads this file. The host-mode dev server reads
# apps/web/.env.development; the compose stack sets VITE_API_URL=/api/v1
# (same-origin via the Vite proxy); production builds receive VITE_API_URL at
# build time (owned by the Docker/CI setup).
VITE_API_URL=http://localhost:8080/api/v1
# Compose-only: host port the web dev server is published on.
WEB_PORT=5173
# Compose-only: set to true if Docker Desktop drops file events across the
# bind mount and Vite HMR stops firing.
# WEB_USE_POLLING=true

# --- Adminer ---
ADMINER_PORT=8081
